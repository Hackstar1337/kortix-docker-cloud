+    let argv: string[];
+    if (bun.exitCode === 0 && /^\/[A-Za-z0-9_./-]+$/.test(bun.stdout.trim())) {
+      await sandbox.files.write(`${PROXY_DIR}/proxy.ts`, DOCKER_CLOUD_PROXY_SOURCE, {}, { timeoutMs: CALL_TIMEOUT_MS });
